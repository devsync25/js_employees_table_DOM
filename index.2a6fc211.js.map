"use strict";
var table = document.querySelector("table");
var tableBody = table.querySelector("tbody");
var headers = table.querySelectorAll("thead th");
var currentColumn = null;
var sortAscending = true;
// Сортировка таблицы при клике на заголовок
headers.forEach(function(header, columnIndex) {
    header.addEventListener("click", function() {
        if (currentColumn === columnIndex) sortAscending = !sortAscending;
        else {
            currentColumn = columnIndex;
            sortAscending = true;
        }
        var rows = Array.from(tableBody.rows);
        rows.sort(function(rowA, rowB) {
            var valueA = rowA.cells[columnIndex].textContent.trim();
            var valueB = rowB.cells[columnIndex].textContent.trim();
            var numberA = Number(valueA.replace(/[$,]/g, ""));
            var numberB = Number(valueB.replace(/[$,]/g, ""));
            var comparison;
            if (!Number.isNaN(numberA) && !Number.isNaN(numberB)) comparison = numberA - numberB;
            else comparison = valueA.localeCompare(valueB);
            return sortAscending ? comparison : -comparison;
        });
        rows.forEach(function(row) {
            return tableBody.append(row);
        });
    });
});
// Выбор строки при клике
tableBody.addEventListener("click", function(e) {
    var row = e.target.closest("tr");
    if (!row) return;
    tableBody.querySelectorAll("tr").forEach(function(item) {
        item.classList.remove("active");
    });
    row.classList.add("active");
});
var form = document.createElement("form");
form.className = "new-employee-form";
form.noValidate = true;
form.innerHTML = '\n  <label>\n    Name:\n    <input name="name" type="text" data-qa="name" required>\n  </label>\n\n  <label>\n    Position:\n    <input name="position" type="text" data-qa="position" required>\n  </label>\n\n  <label>\n    Office:\n    <select name="office" data-qa="office" required>\n      <option value="Tokyo">Tokyo</option>\n      <option value="Singapore">Singapore</option>\n      <option value="London">London</option>\n      <option value="New York">New York</option>\n      <option value="Edinburgh">Edinburgh</option>\n      <option value="San Francisco">San Francisco</option>\n    </select>\n  </label>\n\n  <label>\n    Age:\n    <input name="age" type="number" data-qa="age" required>\n  </label>\n\n  <label>\n    Salary:\n    <input name="salary" type="number" data-qa="salary" required>\n  </label>\n\n  <button type="submit">Save to table</button>\n';
table.after(form);
function showNotification(message, type) {
    var oldNotification = document.querySelector('[data-qa="notification"]');
    if (oldNotification) oldNotification.remove();
    var notification = document.createElement("div");
    notification.dataset.qa = "notification";
    notification.classList.add(type);
    notification.textContent = message;
    document.body.append(notification);
}
form.addEventListener("submit", function(e) {
    e.preventDefault();
    var employeeName = form.elements.name.value.trim();
    var position = form.elements.position.value.trim();
    var office = form.elements.office.value;
    var age = Number(form.elements.age.value);
    var salary = Number(form.elements.salary.value);
    if (employeeName.length < 4 || !position || !office || !form.elements.age.value || !form.elements.salary.value || age < 18 || age > 90) {
        showNotification("Please enter valid employee data", "error");
        return;
    }
    var newRow = tableBody.insertRow();
    newRow.innerHTML = "\n    <td>".concat(employeeName, "</td>\n    <td>").concat(position, "</td>\n    <td>").concat(office, "</td>\n    <td>").concat(age, "</td>\n    <td>$").concat(salary.toLocaleString("en-US"), "</td>\n  ");
    form.reset();
    showNotification("Employee successfully added", "success");
});

